# Copy this file to ".env" to change settings. ".env" is ignored by Git.
# Never put real API keys or passwords in THIS file (.env.example is committed to Git).

# Port the server listens on (always on 127.0.0.1, this PC only)
PORT=3000

# Where the SQLite database file is stored
DATABASE_PATH=data/app.db

# Websites allowed to call the API from a browser (the dashboard), comma-separated
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
